FINNHUB_API_KEY=your_finnhub_api_key_here
# Public navigation URL; the report host handles Cloudflare Access authentication.
NEXT_PUBLIC_PRIVATE_REPORTS_URL=https://baybell.com/private/

# Optional: enables LLM-written Chinese daily close article. Without it, a template article is generated.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DAILY_SUMMARY_MODEL=gpt-4.1-mini
NEXT_PUBLIC_REFRESH_QUOTES_URL=https://baybell-refresh-quotes.<your-subdomain>.workers.dev/
